# Copy to /etc/indoor-nav/api.env on the server; root:root, mode 0600.
# systemd EnvironmentFile syntax: literal values, no shell commands or expansion.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=snapway.work,www.snapway.work
DJANGO_TRUST_PROXY=true
CSRF_TRUSTED_ORIGINS=https://snapway.work,https://www.snapway.work
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@TIGER_HOST:PORT/tsdb
# Same database, with the login permitted to apply schema migrations.
DATABASE_MIGRATOR=postgresql://snapway_migrator:URL_ENCODED_PASSWORD@TIGER_HOST:PORT/tsdb
PGSSLMODE=verify-full
# Use Tiger's downloaded CA path if the service certificate needs a private CA.
PGSSLROOTCERT=system
# Approved Tiger Free-plan demo only: set PGSSLMODE=require, remove PGSSLROOTCERT,
# and set sslmode=require in BOTH URLs if they contain an sslmode query parameter.
# This encrypts traffic without verifying the database server's identity.
MEDIA_ROOT=/srv/indoor-nav/shared/media
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Photo localization (infra/install-place-match.sh). Empty URL disables /api/navigation/localize/.
PLACEMATCH_ENGINE_URL=
# Same value as MOBILE_API_TOKEN in /etc/indoor-nav/placematch.env.
PLACEMATCH_ENGINE_TOKEN=
# APP_RELEASE, STATIC_ROOT and STATIC_URL are supplied by the release controller.
