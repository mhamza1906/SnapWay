# Copy to /etc/indoor-nav/api.env on the server; root:root, mode 0600.
# systemd EnvironmentFile syntax: literal values, no shell commands or expansion.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=snapway.work,www.snapway.work
DJANGO_TRUST_PROXY=true
CSRF_TRUSTED_ORIGINS=https://snapway.work,https://www.snapway.work
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@TIGER_HOST:PORT/tsdb
PGSSLMODE=verify-full
# Use Tiger's downloaded CA path if the service certificate needs a private CA.
PGSSLROOTCERT=system
MEDIA_ROOT=/srv/indoor-nav/shared/media
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# APP_RELEASE, STATIC_ROOT and STATIC_URL are supplied by the release controller.
