# Copy to /etc/indoor-nav/placematch.env on the server; root:root, mode 0600.
# systemd EnvironmentFile syntax: literal values, no shell commands or expansion.
# At least 24 characters, e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(32))'.
# Put the same value in api.env as PLACEMATCH_ENGINE_TOKEN. Never commit or paste it.
MOBILE_API_TOKEN=
# Folder name under /srv/placematch/data/references/.
MOBILE_REFERENCE_SET=
MOBILE_RATE_LIMIT_PER_MIN=60
# The VM has no Google credentials: MegaLoc only.
MOBILE_ENABLE_VERTEX=0
# Never store visitor frames on the server.
MOBILE_STORE_FRAMES=0
# PyTorch CPU threads. Leave one vCPU for the API: 1 on 2 vCPU, 3 on 4 vCPU.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
