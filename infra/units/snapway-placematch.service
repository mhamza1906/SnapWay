# REVIEW TEMPLATE ONLY. Substitute @RELEASE_ID@ and @PLACEMATCH_VENV@ before use.
# Provision pinned weights/calibration/indexes in shared data before a memory probe.
[Unit]
Description=SnapWay optional MegaLoc mobile matching engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snapway
Group=snapway
WorkingDirectory=/srv/indoor-nav/releases/@RELEASE_ID@/source/apps/place-match
EnvironmentFile=/etc/indoor-nav/api.env
UnsetEnvironment=DATABASE_MIGRATOR
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/srv/indoor-nav/releases/@RELEASE_ID@/source/apps/place-match
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=NUMEXPR_NUM_THREADS=2
Environment=MOBILE_STORE_FRAMES=0
Environment=MOBILE_ENABLE_VERTEX=0
Environment=CUDA_VISIBLE_DEVICES=
BindPaths=@PLACEMATCH_DATA@:/srv/indoor-nav/releases/@RELEASE_ID@/source/apps/place-match/data
BindPaths=@PLACEMATCH_RUNS@:/srv/indoor-nav/releases/@RELEASE_ID@/source/apps/place-match/runs
ExecStart=/usr/bin/env PYTHONPATH=/srv/indoor-nav/releases/@RELEASE_ID@/source/apps/place-match OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 NUMEXPR_NUM_THREADS=2 MOBILE_STORE_FRAMES=0 MOBILE_ENABLE_VERTEX=0 CUDA_VISIBLE_DEVICES= @PLACEMATCH_VENV@/bin/python -m placematch.cli serve-mobile --host 127.0.0.1 --port 8790
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@PLACEMATCH_DATA@ @PLACEMATCH_RUNS@
UMask=0077

[Install]
WantedBy=multi-user.target
