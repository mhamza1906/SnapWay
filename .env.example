# Development API profile; bootstrap copies this to ignored local/env/api.env.
# The initial full configuration inventory is preserved in docs/initial/.env.example.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_RELEASE=development
# Blank DATABASE_URL uses SQLite for onboarding only. PostgreSQL is required for
# persistence, concurrency and release acceptance. Fill this explicitly for DB work.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/snapway?sslmode=disable
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
# Provider clients are not activated by initialization. No paid calls are made.
AI_MAX_CALLS_PER_RUN=0
EMBEDDING_ENABLED=false
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
#PostgreSQL database
DATABASE_URL=your_db_url
# Image Storage (Cloudflare R2). Phone /capture photos are stored here only, never on
# disk, under R2_PREFIX/capture/... in a private bucket.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=indoor-navigation-images
R2_PREFIX=snapway
