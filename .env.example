# Development API profile; bootstrap copies this to ignored local/env/api.env.
# The initial full configuration inventory is preserved in docs/initial/.env.example.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_RELEASE=development
# Copy real values into ignored local/env/api.env only (never commit secrets;
# do not use a repo-root .env for this project).
# Tiger Data / Postgres. Leave unset to use local/dev.sqlite3.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
# Google OAuth (django-allauth). Paste Web client values from Google Cloud.
# Until both are set, /accounts/google/login/ cannot complete consent.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional post-login redirects (defaults point at the session identity API).
# LOGIN_REDIRECT_URL=/api/auth/me/
# ACCOUNT_LOGOUT_REDIRECT_URL=/api/auth/me/
# Provider clients are not activated by initialization. No paid calls are made.
AI_MAX_CALLS_PER_RUN=0
EMBEDDING_ENABLED=false
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Image storage placeholders. Prefer S3_* when enabling storage; R2_* optional aliases.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
