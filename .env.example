# Sole active environment contract. Private files: local/.env and /etc/indoor-nav/api.env.
# SAME keys/version on both. See docs/environment-sync.md before sharing updates.
# Flat UTF-8 KEY=value: no quotes, interpolation, inline comments or multiline values.
# URL-encode database passwords; use paths without spaces and forward slashes.
# @secret DJANGO_SECRET_KEY DATABASE_URL DATABASE_MIGRATOR GOOGLE_OAUTH_CLIENT_ID GOOGLE_OAUTH_CLIENT_SECRET
# @secret OPENAI_API_KEY GEMINI_API_KEY ANTHROPIC_API_KEY VERTEX_API_KEY VERTEX_PROJECT
# @secret S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_BUCKET_NAME
# @secret VECTORIZER_API_ID VECTORIZER_API_SECRET
# @secret PLACEMATCH_ENGINE_TOKEN PLACEMATCH_DEV_TOKEN
# @secret PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY
# @secret S3_ENDPOINT_URL S3_BUCKET_NAME
# @override PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY GOOGLE_MAPS_MAP_ID
# @override DJANGO_SETTINGS_MODULE DJANGO_DEBUG DJANGO_ALLOWED_HOSTS DJANGO_TRUST_PROXY
# @override CSRF_TRUSTED_ORIGINS CORS_ALLOWED_ORIGINS MEDIA_ROOT CELERY_BROKER_URL
# @override PGSSLMODE PGSSLROOTCERT DATABASE_CONNECT_TIMEOUT PORT PIPELINE_ALLOWED_ORIGINS
# @override APP_ENV AI_PROVIDER
# @override PLACEMATCH_ENGINE_URL PLACEMATCH_DEV_TOKEN PLACEMATCH_ENGINE_TIMEOUT_S
# @override MOBILE_REFERENCE_SET MOBILE_RATE_LIMIT_PER_MIN
# @required-local DJANGO_SECRET_KEY
# @required-production DJANGO_SECRET_KEY DATABASE_URL DATABASE_MIGRATOR MEDIA_ROOT
ENV_SCHEMA_VERSION=2026-10-17.6
# Local defaults. Production: config.settings.production / false / explicit hosts / true.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TRUST_PROXY=false
# Blank DATABASE_URL selects offline local SQLite only; production requires PostgreSQL.
DATABASE_URL=
DATABASE_MIGRATOR=
DATABASE_CONNECT_TIMEOUT=10
PGSSLMODE=verify-full
PGSSLROOTCERT=system
# Approved demo: PGSSLMODE=require and PGSSLROOTCERT= (retain the empty key).
MEDIA_ROOT=local/media
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Browser-visible Maps credential: restrict to websites and Maps JavaScript API.
# A separate production website key is an approved host-specific exception.
PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
LOGIN_REDIRECT_URL=/api/auth/me/
ACCOUNT_LOGOUT_REDIRECT_URL=/api/auth/me/
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# APP_ENV selects a provider policy, not a second file or deployment tier.
APP_ENV=prod
AI_PROVIDER=vertex
PORT=5175
PIPELINE_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
VERTEX_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-4-argon
VERTEX_EFFORT=high
# Initialization placeholders below are not a universal paid-call enforcement switch.
AI_MAX_CALLS_PER_RUN=0
EMBEDDING_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=high
# Merged iOS/localization contract; an actual engine still needs explicit setup.
# Blank engine settings keep that integration unavailable; do not invent tokens.
PLACEMATCH_ENGINE_URL=
PLACEMATCH_ENGINE_TOKEN=
PLACEMATCH_ENGINE_TIMEOUT_S=30
# Optional DEBUG-only local bearer; leave empty in production.
PLACEMATCH_DEV_TOKEN=
LOCALIZATION_RATE=60/min
MOBILE_REFERENCE_SET=default
MOBILE_RATE_LIMIT_PER_MIN=60
MOBILE_STORE_FRAMES=0
MOBILE_ENABLE_VERTEX=1
# Object storage (Cloudflare R2 via S3-compatible API). Prefer S3_* for runtime.
# Endpoint example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION_NAME=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path
S3_SIGNED_URL_TTL_SECONDS=300
# Optional R2_* aliases when S3_* are empty (derived endpoint from account id).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Phone /capture photos go to this bucket only (never disk), under this prefix.
CAPTURE_R2_PREFIX=snapway
# Demo policy: disabled everywhere, both credentials empty.
VECTORIZER_API_ID=
VECTORIZER_API_SECRET=
VECTORIZER_LIVE_ENABLED=false
# Hard cap on vectorizer.ai requests (scripts and /api/vectorization/live); refused when APP_ENV=prod.
VECTORIZER_MAX_CALLS=50
# APP_RELEASE, STATIC_ROOT, STATIC_URL and PYTHONPATH are deployment-managed.

