# Shared, non-secret settings for both environments. Server only.
# APP_ENV picks the credentials file: prod -> .env.prod, dev -> .env.dev.
#   Everyone on the team: copy .env.prod.example to .env.prod and run `npm run prod`
#   (Gemini on Vertex AI).
#   .env.dev (Claude via the Anthropic API) is for Arjun only; it needs his key.
PORT=5175
# Origins allowed to call this service from a browser (Angular dev server).
PIPELINE_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
