# Development environment for Arjun only (Claude via the Anthropic API).
# Teammates: use .env.prod (Claude by default, Gemini on Vertex selectable).
# Server only; never expose these values to Angular.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=high
# The clean-plan stage always uses a Gemini image model on Vertex AI, also in dev.
VERTEX_API_KEY=your_vertex_api_key
VERTEX_PROJECT=your_google_cloud_project
VERTEX_LOCATION=global
VERTEX_IMAGE_MODEL=gemini-nano-banana-2.1
VERTEX_IMAGE_SIZE=2K
