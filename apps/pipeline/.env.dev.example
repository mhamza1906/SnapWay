# Development environment for Arjun only (Claude via the Anthropic API).
# Teammates: do not create .env.dev; use .env.prod (Gemini on Vertex AI).
# Server only; never expose these values to Angular.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=high
# The clean-plan stage always uses Nano Banana Pro on Vertex AI, also in dev.
VERTEX_API_KEY=your_vertex_api_key
VERTEX_PROJECT=your_google_cloud_project
VERTEX_LOCATION=global
VERTEX_IMAGE_MODEL=gemini-3-pro-image
VERTEX_IMAGE_SIZE=2K
