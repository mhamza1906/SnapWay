# Development environment for Arjun only (Claude via the Anthropic API).
# Teammates: use .env.prod (Claude by default, Gemini on Vertex selectable).
# Server only; never expose these values to Angular.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=high
# Optional: Gemini on Vertex AI (only used with AI_PROVIDER=vertex).
VERTEX_API_KEY=your_vertex_api_key
VERTEX_PROJECT=your_google_cloud_project
VERTEX_LOCATION=global

# vectorizer.ai (raster plan -> SVG). Dev only; the prod server refuses to vectorize.
VECTORIZER_API_ID=
VECTORIZER_API_SECRET=
VECTORIZER_MAX_CALLS=50
