# Production / team environment: Gemini on Vertex AI. Server only.
# Everyone except Arjun uses this file: copy to .env.prod and run `npm run prod`.
# Prod accepts only AI_PROVIDER=vertex; it never reads .env.dev.
AI_PROVIDER=vertex
VERTEX_API_KEY=your_vertex_api_key
VERTEX_PROJECT=your_google_cloud_project
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-4-argon
# low, medium or high (Gemini thinking level)
VERTEX_EFFORT=high
# Clean-plan stage: redraws each floor before mapping (Nano Banana Pro). Same key/project.
VERTEX_IMAGE_MODEL=gemini-3-pro-image
# 1K, 2K or 4K
VERTEX_IMAGE_SIZE=2K
