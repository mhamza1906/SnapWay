# Production / team environment. Server only: copy to .env.prod (git-ignored)
# and run `npm run prod`. Never commit a real key.
#
# Planning and mapping run on Claude (Anthropic): Sonnet 5.5, high effort.
# To switch mapping back to Gemini on Vertex AI, set AI_PROVIDER=vertex.
# There is no automatic fallback between providers.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5-5
# low, medium, high, xhigh or max
ANTHROPIC_EFFORT=high

# Vertex AI: always needed for the clean-plan images, and for mapping when
# AI_PROVIDER=vertex.
VERTEX_API_KEY=your_vertex_api_key
VERTEX_PROJECT=your_google_cloud_project
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-4-argon
# low, medium or high (Gemini thinking level)
VERTEX_EFFORT=high
# Clean-plan stage: redraws each floor before mapping.
# Default Nano Banana 2.1; for the most faithful redraws use gemini-3-pro-image (Nano Banana Pro).
VERTEX_IMAGE_MODEL=gemini-nano-banana-2.1
# 1K, 2K or 4K
VERTEX_IMAGE_SIZE=2K
