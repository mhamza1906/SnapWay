# Production / team environment: Gemini on Vertex AI. Server only.
# Everyone except Arjun uses this file: copy to .env.prod and run `npm run prod`.
# Prod accepts only AI_PROVIDER=vertex; it never reads .env.dev.
AI_PROVIDER=vertex
VERTEX_API_KEY=your_vertex_api_key
VERTEX_PROJECT=your_google_cloud_project
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-4-argon
# low, medium or high (Gemini thinking level)
VERTEX_EFFORT=high
# Optional cloud storage (docs/pipeline/storage.md). Leave empty to keep local files only.
# Tiger Data PostgreSQL: postgres://USER@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=
# Database password if it is not in DATABASE_URL.
PGPASSWORD=
# Cloudflare R2 (S3-compatible) for uploaded plans.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
