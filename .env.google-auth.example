# Copy to ignored local/env/google-auth.env. Reserved for future backend integration.
# These values are not consumed by the current Django scaffold or frontend UI.
# Never inject CLIENT_SECRET into Angular, browser runtime configuration or Git.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=openid,email,profile
# Leave blank until backend confirms its mounted callback URL.
GOOGLE_OAUTH_CALLBACK_URL=
