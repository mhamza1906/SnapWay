# Copy to ignored local/env/web.env. This file does not automatically configure Angular.
# scripts/google_maps_smoke.py reads only the Maps values for an isolated browser test.
# Browser-visible values; protect the Maps key with website + API restrictions.
PUBLIC_APP_ORIGIN=http://localhost:4200
GOOGLE_CLOUD_PROJECT_ID=
PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Reserved for later frontend identity integration; unused by the Maps smoke test.
PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
