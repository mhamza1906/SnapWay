digraph schema {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.5", nodesep="0.3", ranksep="0.6", splines=spline, fontname="Arial", compound=true, labeljust=l, labelloc=t];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=9, color="#94a3b8", fontcolor="#475569", arrowsize=0.65];
