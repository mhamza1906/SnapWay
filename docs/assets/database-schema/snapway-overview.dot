subgraph cluster_5 { label="Durable jobs"; style="rounded,filled"; fillcolor="white"; color="#e2e8f0"; fontcolor="#be185d"; fontsize=15; margin=18;
"jobs_job" [id="overview-jobs_job", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#be185d"><FONT COLOR="white"><B>jobs_job</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">PK id · 22 columns</FONT></TD></TR></TABLE>>, tooltip="snapway.jobs_job"];
