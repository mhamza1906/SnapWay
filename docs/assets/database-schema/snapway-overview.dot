"maps_contribution" [id="overview-maps_contribution", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#2563eb"><FONT COLOR="white"><B>maps_contribution</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">PK id · 10 columns</FONT></TD></TR></TABLE>>, tooltip="snapway.maps_contribution"];
"maps_changeset" [id="overview-maps_changeset", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#2563eb"><FONT COLOR="white"><B>maps_changeset</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">PK id · 11 columns</FONT></TD></TR></TABLE>>, tooltip="snapway.maps_changeset"];
