"maps_asset" -> "maps_referencephoto" [dir=back, id="overview-edge-14", label="asset_id", tooltip="FOREIGN KEY (asset_id) REFERENCES maps_asset(id) DEFERRABLE INITIALLY DEFERRED"];
"maps_revision" -> "maps_review" [dir=back, id="overview-edge-15", label="revision_id", tooltip="FOREIGN KEY (revision_id) REFERENCES maps_revision(id) DEFERRABLE INITIALLY DEFERRED"];
