}
"maps_revision" -> "jobs_job" [dir=back, id="overview-edge-0", label="revision_id", tooltip="FOREIGN KEY (revision_id) REFERENCES maps_revision(id) DEFERRABLE INITIALLY DEFERRED"];
"jobs_job" -> "jobs_jobattempt" [dir=back, id="overview-edge-1", label="job_id", tooltip="FOREIGN KEY (job_id) REFERENCES jobs_job(id) DEFERRABLE INITIALLY DEFERRED"];
"maps_maptarget" -> "maps_asset" [dir=back, id="overview-edge-2", label="target_id", tooltip="FOREIGN KEY (target_id) REFERENCES maps_maptarget(id) DEFERRABLE INITIALLY DEFERRED"];
