digraph schema {
graph [rankdir=TB, bgcolor="#f8fafc", pad="0.5", nodesep="0.3", ranksep="0.6", splines=spline, fontname="Arial", compound=true, labeljust=l, labelloc=t];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=9, color="#94a3b8", fontcolor="#475569", arrowsize=0.65];
subgraph cluster_0 { label="Places & contributions"; style="rounded,filled"; fillcolor="white"; color="#e2e8f0"; fontcolor="#2563eb"; fontsize=15; margin=18;
"maps_building" [id="overview-maps_building", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#2563eb"><FONT COLOR="white"><B>maps_building</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">PK id · 8 columns</FONT></TD></TR></TABLE>>, tooltip="snapway.maps_building"];
"maps_floor" [id="overview-maps_floor", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#2563eb"><FONT COLOR="white"><B>maps_floor</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">PK id · 6 columns</FONT></TD></TR></TABLE>>, tooltip="snapway.maps_floor"];
