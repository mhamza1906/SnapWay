}
subgraph cluster_1 { label="Revision & walkable graph"; style="rounded,filled"; fillcolor="white"; color="#e2e8f0"; fontcolor="#7c3aed"; fontsize=15; margin=18;
"maps_revision" [id="overview-maps_revision", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#7c3aed"><FONT COLOR="white"><B>maps_revision</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">PK id · 15 columns</FONT></TD></TR></TABLE>>, tooltip="snapway.maps_revision"];
