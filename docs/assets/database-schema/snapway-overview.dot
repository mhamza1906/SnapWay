"maps_building" -> "maps_floor" [dir=back, id="overview-edge-7", label="building_id", tooltip="FOREIGN KEY (building_id) REFERENCES maps_building(id) DEFERRABLE INITIALLY DEFERRED"];
"maps_revision" -> "maps_mapobject" [dir=back, id="overview-edge-8", label="revision_id", tooltip="FOREIGN KEY (revision_id) REFERENCES maps_revision(id) DEFERRABLE INITIALLY DEFERRED"];
"maps_floor" -> "maps_maptarget" [dir=back, id="overview-edge-9", label="floor_id", tooltip="FOREIGN KEY (floor_id) REFERENCES maps_floor(id) DEFERRABLE INITIALLY DEFERRED"];
"maps_maptarget" -> "maps_membership" [dir=back, id="overview-edge-10", label="target_id", tooltip="FOREIGN KEY (target_id) REFERENCES maps_maptarget(id) DEFERRABLE INITIALLY DEFERRED"];
"maps_room" -> "maps_node" [dir=back, id="overview-edge-11", label="room_id", tooltip="FOREIGN KEY (room_id) REFERENCES maps_room(id) DEFERRABLE INITIALLY DEFERRED"];
