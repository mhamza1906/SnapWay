"navigation_navigationsession" [id="overview-navigation_navigationsession", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#ea580c"><FONT COLOR="white"><B>navigation_navigationsession</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">PK id · 11 columns</FONT></TD></TR></TABLE>>, tooltip="snapway.navigation_navigationsession"];
