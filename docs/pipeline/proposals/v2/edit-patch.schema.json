{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental reviewable floor-plan edit proposal",
  "description": "Local validation contract, not an existing HTTP API. Project one selected operation into provider-supported tool schemas before calling a model.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "base_revision", "operations"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "request_id": {"type": "string", "minLength": 1},
    "base_revision": {"type": "integer", "minimum": 0},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "target_id", "text"],
            "properties": {
              "op": {"type": "string", "enum": ["set_label"]},
              "target_id": {"type": "string", "minLength": 1},
              "text": {"type": "string", "maxLength": 100}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "target_id", "tread_angle_deg", "tread_count"],
            "properties": {
              "op": {"type": "string", "enum": ["set_stair_presentation"]},
              "target_id": {"type": "string", "minLength": 1},
              "tread_angle_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
              "tread_count": {"type": "integer", "minimum": 1, "maximum": 80}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "target_id", "swing"],
            "properties": {
              "op": {"type": "string", "enum": ["set_door_presentation"]},
              "target_id": {"type": "string", "minLength": 1},
              "swing": {"type": "string", "enum": ["left", "right", "unknown"]}
            }
          }
        ]
      }
    }
  }
}
