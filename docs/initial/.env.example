# Indoor navigation configuration inventory. No application loader exists yet.
# Copy selected settings to PRIVATE local/env/ or deployment secrets later.
# This is a union of API, worker, MCP, frontend-build, Android and CI settings:
# inject only the keys each service needs; NEVER ship this entire file to Angular.
# Blank required values must cause a clear startup/profile validation failure.
# Names are project conventions except documented SDK/libpq variables.
# Current planning sources: architecture and the two integration guides.

# General server settings
APP_ENV=development
APP_PUBLIC_URL=https://nav.example.com
APP_RELEASE=replace_with_commit_sha
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=nav.example.com,localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Toronto
DJANGO_LOG_LEVEL=INFO
# Configure trusted proxy handling in Django; never trust arbitrary forwarded headers.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SESSION_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=https://nav.example.com
# Angular defaults: XSRF-TOKEN cookie and X-XSRF-TOKEN header.
# The Django loader must explicitly map these names to CSRF settings.
DJANGO_CSRF_COOKIE_NAME=XSRF-TOKEN
DJANGO_CSRF_HEADER_NAME=HTTP_X_XSRF_TOKEN
# Obtain a CSRF cookie through the app's own authenticated/bootstrap flow.
DJANGO_CSRF_COOKIE_HTTPONLY=false
# Verify the actual Android WebView origin; this is the documented baseline candidate.
CORS_ALLOWED_ORIGINS=https://localhost
# Public Android navigation uses scoped authorization, not browser session cookies.
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_HEADERS=accept,authorization,content-type,x-capture-id,x-idempotency-key
STATIC_URL=/django-static/
STATIC_ROOT=/srv/indoor-nav/shared/static

# Tiger Data is the production PostgreSQL service, not an additional database.
# Copy the DIRECT PostgreSQL URI from your service; URL-encode credentials.
# Example shape: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
# Separate direct migration role/connection; default to runtime URL only deliberately.
DATABASE_MIGRATION_URL=
# libpq settings; URL query arguments take precedence if supplied there too.
# system requires a compatible libpq (16+) and an installed CA trust store.
# For a provider-issued CA, use its mounted path instead. Do not disable verification.
PGSSLMODE=verify-full
PGSSLROOTCERT=system
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_CONN_MAX_AGE=0
# Set true when a selected transaction pool requires disabling server-side cursors.
DATABASE_DISABLE_SERVER_SIDE_CURSORS=false
DATABASE_POOL_MODE=direct
# pgvector stays optional until the service extension/profile is verified.
DATABASE_VECTOR_EXTENSION_ENABLED=false
# Local-only PostgreSQL service settings; never deploy this as a second production DB.
LOCAL_POSTGRES_DB=indoor_nav
LOCAL_POSTGRES_USER=indoor_nav
LOCAL_POSTGRES_PASSWORD=
# Local cleartext DB on trusted loopback may use sslmode=disable
# in its LOCAL DATABASE_URL only; retain verified TLS for Tiger Data connections.

# Private queue and worker settings
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# The application's Job table is authoritative; no Celery result backend required.
CELERY_RESULT_BACKEND=
LOCALIZATION_QUEUE=localization
AUTHORING_QUEUE=authoring
LOCALIZATION_WORKER_CONCURRENCY=1
AUTHORING_WORKER_CONCURRENCY=1
JOB_MAX_AUTOMATIC_RETRIES=2
LOCALIZATION_TIMEOUT_SECONDS=20
AUTHORING_JOB_TIMEOUT_SECONDS=300
JOB_RECOVERY_SCAN_SECONDS=30
# Bind Redis to loopback/private sockets; set credentials if the selected setup needs them.

# Persistent image/vector/index storage, shared by API and workers
MEDIA_STORAGE_BACKEND=filesystem
MEDIA_ROOT=/srv/indoor-nav/shared/media
INDEX_ROOT=/srv/indoor-nav/shared/indexes
# S3-compatible object storage is an OPTIONAL alternative to persistent local storage.
S3_ENDPOINT_URL=
S3_REGION_NAME=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path
S3_SIGNED_URL_TTL_SECONDS=300

# Google OAuth / OpenID Connect: developer WEB login, via Django/allauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=openid,email,profile
# Register this exact URI at Google and map it to the mounted allauth routes.
GOOGLE_OAUTH_CALLBACK_URL=https://nav.example.com/accounts/google/login/callback/
# Native Google login is not required for anonymous public navigation.
NATIVE_GOOGLE_LOGIN_ENABLED=false

# Gemini first: model IDs documented at research time, still require project probes
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_MODE=interactions
GEMINI_API_VERSION=v1beta
GEMINI_STORE_INTERACTIONS=false
GEMINI_VISION_MODEL=gemini-4-argon
GEMINI_VISION_FAST_MODEL=gemini-3.8-flash
GEMINI_MULTIMODAL_MODEL=gemini-3.8-flash
AI_MODELING_PROVIDER=gemini
GEMINI_MODELING_MODEL=gemini-4-argon
# Designated vector-modeling backup; invoke through a recorded, bounded retry.
AI_MODELING_FALLBACK_PROVIDER=anthropic
AI_REQUEST_TIMEOUT_SECONDS=20
AI_AUTHORING_REQUEST_TIMEOUT_SECONDS=300
AI_PROMPT_VERSION=replace_with_prompt_revision
AI_OUTPUT_SCHEMA_VERSION=replace_with_schema_revision
AI_MAX_AGENT_TOOL_STEPS=12
AI_MAX_REPAIR_ATTEMPTS=2

# Raster image generation/editing is a distinct capability from vision-to-text.
# User-selected GPT Image 2.5 raster workflow; OpenAI key required when enabled.
IMAGE_GENERATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Opus 5.5 is the selected vector-modeling backup; account probe before activation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELING_MODEL=claude-opus-5-5

# Requested "Gemini Embedding 4" API ID was not established in official docs.
# Explicit corrected recommendation: stable Gemini Embedding 2, initially 768 dimensions.
# Verify account access and retrieval quality before enabling; reindex if changed.
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_INPUT_KIND=text
EMBEDDING_STORAGE=numpy
EMBEDDING_NORMALIZATION=l2
EMBEDDING_PREPROCESS_VERSION=replace_with_text_normalization_revision
EMBEDDING_PROMPT_VERSION=replace_with_embedding_prompt_revision
# Adapter-specific: populate task_type only for models that support it.
EMBEDDING_DOCUMENT_TASK_TYPE=
EMBEDDING_QUERY_TASK_TYPE=
# For Embedding 2 these are full formatting templates, not literal prepend strings.
# Substitute reviewed text, use title=none if absent, and never eval these templates.
EMBEDDING_DOCUMENT_PREFIX="title: {title} | text: {content}"
EMBEDDING_QUERY_PREFIX="task: search result | query: {content}"
# Approximate pgvector indexes have dimension/operator limits; see integration guide.

# Private MCP adapter for the application's agent; not public by default
MCP_ENABLED=true
MCP_PUBLIC_ENABLED=false
MCP_TRANSPORT=streamable-http
MCP_INTERNAL_URL=http://127.0.0.1:8001/mcp
MCP_INTERNAL_AUDIENCE=indoor-map-tools
# Dedicated secret for a short-lived internal delegation token, validated server-side.
MCP_INTERNAL_SIGNING_KEY=
MCP_DELEGATION_TTL_SECONDS=300
MCP_MAX_BATCH_OPERATIONS=100
# Remote third-party MCP access needs a separate standards-compliant auth setup.
MCP_PUBLIC_URL=
MCP_AUTH_ISSUER_URL=
# Website information import: app must reject private-network targets/unsafe redirects.
WEBSITE_FETCH_TIMEOUT_SECONDS=15
WEBSITE_FETCH_MAX_BYTES=2000000
WEBSITE_FETCH_MAX_REDIRECTS=3

# Outdoor navigation: baseline handoff; embedded maps/routes are selectable profiles
OUTDOOR_NAVIGATION_MODE=maps_url
# Server-only Routes/Places credentials when those integrations are enabled
GOOGLE_MAPS_SERVER_API_KEY=
# Native SDK key is embedded/public and needs package + signing-certificate restrictions.
# Do not reuse the web key or assume WebView requests count as native SDK traffic.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_MAP_ID=

# PUBLIC frontend build/runtime allowlist. These values are not secrets.
# Angular does NOT automatically read .env; implement explicit configuration mapping.
PUBLIC_WEB_ORIGIN=https://nav.example.com
# APK profile requires an absolute reachable URL; same-origin browser profile uses /api.
# Build/config mapping must select that browser-relative URL for Angular XSRF handling.
PUBLIC_API_BASE_URL=https://nav.example.com/api
PUBLIC_BUILD_SHA=replace_with_commit_sha
PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
PUBLIC_OUTDOOR_NAVIGATION_MODE=maps_url
PUBLIC_REFERENCE_TOUR_ENABLED=false
PUBLIC_ANIMATED_GUIDANCE_ENABLED=false
PUBLIC_SENSOR_GUIDANCE_ENABLED=false
PUBLIC_AUTOMATIC_CAPTURE_ENABLED=false
PUBLIC_3D_GUIDANCE_ENABLED=false
# Development browser may use /api through a proxy; bundled APK needs a reachable HTTPS URL.

# Upload/session controls: initial trial values, validate against actual reference detail
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
MAX_INFLIGHT_JOBS_PER_SESSION=1
MAX_PROJECT_INFLIGHT_JOBS=4
QUERY_RETENTION_HOURS=24
# Set a finite real-call ceiling before a provider experiment; zero disables new paid calls.
AI_MAX_CALLS_PER_RUN=0

# Android build and CI only; never include signing passwords in the APK
CAPACITOR_APP_ID=org.example.indoornav
CAPACITOR_APP_NAME=IndoorNavigation
# Change to the actual Angular output directory containing index.html.
CAPACITOR_WEB_DIR=dist/indoor-nav/browser
ANDROID_KEYSTORE_PATH=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# Deployment/operations only. Vultr/GoDaddy console setup needs no runtime account API key.
CADDY_DOMAIN=nav.example.com
ACME_EMAIL=
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY_PATH=
DEPLOY_ROOT=/srv/indoor-nav
RELEASE_ID=replace_with_commit_sha
# Candidate API ports for two native systemd release slots; not public ingress.
API_BLUE_PORT=8101
API_GREEN_PORT=8102
BACKUP_TARGET=
