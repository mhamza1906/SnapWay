{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental bounded floor-plan trace response",
  "description": "Proposal only. Validate locally, verify frame echoes and evidence, then adapt to BuildingSchema v2; never apply model JSON directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "frame_id",
    "coordinate_space",
    "spaces",
    "opening_candidates",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_space": {
      "type": "string",
      "enum": [
        "crop_n1000_xy"
      ]
    },
    "spaces": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id",
          "role",
          "polygon",
          "label_refs",
          "observation"
        ],
        "properties": {
          "local_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "room",
              "circulation",
              "stair_landing",
              "stair_flight",
              "elevator_shaft",
              "void",
              "unknown"
            ]
          },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "maxItems": 48,
            "items": {
              "$ref": "#/$defs/point"
            }
          },
          "label_refs": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "observation": {
            "type": "string",
            "enum": [
              "visible",
              "ambiguous",
              "unreadable"
            ]
          }
        }
      }
    },
    "opening_candidates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id",
          "a",
          "b",
          "adjacent_local_ids",
          "observed",
          "evidence_region"
        ],
        "properties": {
          "local_id": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "$ref": "#/$defs/point"
          },
          "b": {
            "$ref": "#/$defs/point"
          },
          "adjacent_local_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "observed": {
            "type": "string",
            "enum": [
              "door",
              "open_passage",
              "unclear"
            ]
          },
          "evidence_region": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/point"
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_ref",
          "code",
          "reason"
        ],
        "properties": {
          "target_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "clipped",
              "ambiguous_geometry",
              "missing_label",
              "different_floor",
              "capacity",
              "unreadable"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 180
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  }
}
